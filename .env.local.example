# 한국은행 ECOS Open API 인증키 (필수)
# 발급: https://ecos.bok.or.kr → 오픈API → 인증키 신청
ECOS_API_KEY=

# FRED API 키 (선택)
# 비워두면 키가 필요 없는 fredgraph CSV 엔드포인트를 사용한다.
# 발급: https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=

# Claude API 키 — "3. 주간 모니터링" 탭이 지난 일주일 뉴스를 요약할 때 쓴다 (없으면 그 탭만 안내문이 뜬다)
# 발급: https://platform.claude.com → API Keys
ANTHROPIC_API_KEY=

# (선택) 주간 모니터링에 쓸 모델. 비우면 claude-opus-5-5
WEEKLY_MODEL=
